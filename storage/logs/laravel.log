[2025-07-30 16:00:27] local.INFO: Product variants: [{"id":25,"product_id":25,"attribute_value_id":null,"sku":"PRD-1751382684972-KHÔNGC-0","barcode":null,"name":"không cay - Có ruốc","description":"Món ăn được chế biến không cay, phù hợp cho những ai không thích hoặc không ăn được vị cay nồng đặc trưng của nhiều món truyền thống. Thành phần chính của món ăn là những nguyên liệu tươi ngon, được lựa chọn kỹ càng để đảm bảo hương vị tự nhiên và độ tươi mới. Đặc biệt, món ăn có thêm ruốc – một loại gia vị khô làm từ thịt hoặc tôm được xé nhỏ và sấy khô, mang đến vị mặn ngọt dịu nhẹ, tạo nên điểm nhấn đặc biệt cho món. Ruốc được rắc đều lên bề mặt, không quá nhiều để tránh át mất hương vị chính, nhưng đủ để mỗi miếng ăn đều cảm nhận được vị thơm béo, bùi bùi của ruốc. Món ăn không sử dụng ớt hay các loại gia vị cay, nên vị giác người thưởng thức chỉ cảm nhận được vị ngọt thanh của nguyên liệu chính hòa quyện cùng vị đậm đà, hơi mặn nhẹ của ruốc. Ngoài ra, màu sắc của món ăn cũng khá bắt mắt với sắc vàng nhẹ của ruốc, kết hợp cùng màu xanh tươi của rau thơm hoặc các loại rau ăn kèm, tạo cảm giác hấp dẫn, ngon miệng. Món ăn rất thích hợp cho bữa sáng hoặc bữa nhẹ trong ngày, giúp bạn bổ sung năng lượng mà không bị nóng hay khó chịu do cay. Đây là lựa chọn lý tưởng cho những ai yêu thích ẩm thực nhẹ nhàng, tinh tế, đồng thời muốn trải nghiệm hương vị ruốc đặc trưng nhưng không muốn cay.","image":"products/variants/variant-1751382712-6863fab8f21b8.jpg","price":"150000.00","weight":null,"volume":null,"stock":48,"active":1,"created_at":"2025-07-01T15:11:52.000000Z","updated_at":"2025-07-28T08:32:45.000000Z","deleted_at":null,"attribute_values":[{"id":110,"attribute_id":31,"value":"không cay","slug":"khong-cay","created_at":"2025-06-12T10:06:07.000000Z","updated_at":"2025-06-12T10:06:07.000000Z","deleted_at":null,"pivot":{"product_variant_id":25,"attribute_value_id":110,"attribute_id":31}},{"id":117,"attribute_id":33,"value":"Có ruốc","slug":"co-ruoc","created_at":"2025-06-12T1